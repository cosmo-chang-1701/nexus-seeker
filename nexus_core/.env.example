# ==========================================
# Nexus Seeker Core - Environment Variables
# ==========================================

# 1. 核心機器人設定 (必填)
# 取得方式: https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_ADMIN_USER_ID=123456789012345678

# 2. 金融數據源設定 (必填)
# 取得方式: https://finnhub.io/
FINNHUB_API_KEY=your_finnhub_api_key_here

# 3. 邊緣爬蟲服務 API 設定 (必填)
# 當您部署 nexus_edge_scraper 後，Cloudflare Tunnel 產生的外部 URL
TUNNEL_URL=https://your-tunnel-url-here.trycloudflare.com

# 4. LLM 模型服務設定 (選填 / 供 Analyst Agent 與心跳摘要使用)
# 支援 OpenAI 相容之 API (例如: OpenAI, Groq, 或是本地端 vLLM/Ollama)
LLM_API_BASE=your_llm_api_base_here
LLM_MODEL_NAME=your_llm_model_name_here
API_KEY=your_api_key_here

# 5. 系統與開發設定 (選填)
# 預設為 WARNING, 開發時可設為 DEBUG 或 INFO
LOG_LEVEL=WARNING

# 6. 動態轉倉引擎：選擇權部位接入開關 (選填 / 預設關閉)
# 分兩道閘門做 staged rollout，避免選擇權相關分支 (3-5m 快速出場、流動性警告等)
# 在未經觀察期前意外對使用者發送清倉指令：
#   ENABLE_OPTIONS_ROLLOVER_INGESTION=true  → 選擇權部位才會被讀進 15 分鐘評估迴圈
#   OPTIONS_ROLLOVER_DRY_RUN=false          → 才會真的發送 DM (預設 true 僅記錄稽核軌跡)
# 建議先只開 ENABLE_OPTIONS_ROLLOVER_INGESTION、保留 OPTIONS_ROLLOVER_DRY_RUN=true
# 觀察一段時間 (檢查 log 與 rollover_audit_log 資料表)，確認判斷合理後再關閉 dry-run。
ENABLE_OPTIONS_ROLLOVER_INGESTION=false
OPTIONS_ROLLOVER_DRY_RUN=true
